            <point key="rainfall" name="丰乐" senid="1442852542202112.M12000" weight="0.25"/>
            <point key="rainfall" name="土溪" senid="1442852617773312.M12000" weight="0.13"/>
        </station>

        <station code="TANK_DAHEKOU_UPSTREAM" name="大河口以上" model="THREE_LAYER_TANK"
                 params="TANK_DAHEKOU_UPSTREAM_V1">
            <resultPoint kind="TANK" field="*" idAttrCode="15400103021004"/>
            <gfs regionId="2000000006" subtype="10051"/>
            <point key="rainfall" name="朝阳寺" senid="1442852634059008.M12000" weight="0.26"/>
            <point key="rainfall" name="梯子洞" senid="1442852620722432.M12000" weight="0.1"/>
