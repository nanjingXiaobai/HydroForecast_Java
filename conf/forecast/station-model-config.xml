        <station code="TANK_PENGSHUI_INFLOW" name="彭水" model="THREE_LAYER_TANK"
                 aggregation="PENGSHUI_INFLOW_FORECAST">
            <resultPoint kind="PENGSHUI" field="jiangbinFlow" idAttrCode="11802203021004"/>
            <resultPoint kind="PENGSHUI" field="dahekouFlow" idAttrCode="15400103021004"/>
            <resultPoint kind="PENGSHUI" field="yangongFlow" idAttrCode="11802403021010"/>
            <resultPoint kind="PENGSHUI" field="gongpengFlow" idAttrCode="11800103021028"/>
            <resultPoint kind="PENGSHUI" field="regionalFlowTotal" idAttrCode="11800103021010"/>
            <resultPoint kind="PENGSHUI" field="pengshuiInflow" idAttrCode="11800103021004"/>
            <point key="pengshuiInflow" name="彭水入库" senid="1442213928845568.W14000"/>
            <point key="shatuoOutflow" name="沙沱出库" senid="1442213919031552.W14100"/>
        </station>

        <station code="REGRESSION_SHATUO" name="沙沱" model="SHATUO_LSTM_MOS"
                 params="REGRESSION_SHATUO_AUTO_MOS">
            <!-- 现场WEA_GFSFORRAIN未提供沙沱或构皮滩对应REGID，暂由DAYDB多年均值补齐未来雨量。 -->
            <point key="shatuoInflow" name="沙沱入库" senid="1442213919031552.W14000"/>
            <point key="shatuoOutflow" name="沙沱出库" senid="1442213919031552.W14100"/>
