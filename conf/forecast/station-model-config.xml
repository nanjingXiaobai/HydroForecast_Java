<?xml version="1.0" encoding="UTF-8"?>
<!--
  云南大唐站点与模型配置（简化版）。
  固定规则无需配置：历史表按模型时步选择HOURDB或DAYDB、预报表WEA_GFSFORRAIN、预报降雨字段AVERPRE。
  senid属性必须填写现场HOURDB或DAYDB中ID_ATTR_CODE的完整值，例如雨量0335030024.M12000、流量0207000000.W14000。
  水箱实测点号及权重、预报REGID来自已确认雨量权重Excel；水箱自动预报SUBTYPE为10051。
-->
<forecast-station-model-config schemaVersion="2.0" configVersion="2026.11.04-tank-auto" environment="production">

    <!-- 水箱每日自动计算并保存，北京时间HH:mm，开关和时间支持热更新。 -->
    <tankAutoForecast enabled="true" time="23:00"/>

    <models>
        <model code="API_PPAR_UH" name="API产汇流模型" module="API_MODEL" config="forecast.models.api"/>
        <model code="THREE_LAYER_TANK" name="三层水箱模型" module="TANK_MODEL" config="forecast.models.tank"/>
        <model code="SHATUO_LSTM_MOS" name="沙沱LSTM/MOS回归模型" module="REGRESSION_MODEL"
               config="forecast.models.regression.shatuo"/>
    </models>

    <!-- API参数明细从数据库读取，这里只保存稳定的参数方案编号。 -->
    <parameterProfiles>
        <apiProfile code="API_YUJIANKOU_V1" sourceKey="API_YUJIANKOU_V1"/>
        <apiProfile code="API_JIAOMUTANG_V1" sourceKey="API_JIAOMUTANG_V1"/>
        <apiProfile code="API_TENGZIGOU_UPSTREAM_V1" sourceKey="API_TENGZIGOU_UPSTREAM_V1"/>
        <apiProfile code="API_TENGZIGOU_NIULANKOU_V1" sourceKey="API_TENGZIGOU_NIULANKOU_V1"/>

        <!-- 水箱参数来自已确认Excel，仍保留为可替换配置。 -->
        <tankProfile code="TANK_JIANGBIN_UPSTREAM_V1" areaFactor="2479" routingMode="TO_TANK3">
            <evaporation threshold1="3" threshold2="10" value1="3" value2="2" value3="1"/>
            <tank1 upperCoefficient="0.3" upperThreshold="60" middleCoefficient="0.25" middleThreshold="35"
                   lowerCoefficient="0.2" lowerThreshold="15" infiltrationCoefficient="0.05"/>
            <tank2 outflowCoefficient="0.05" outflowThreshold="40" percolationCoefficient="0.01"/>
            <tank3 middleCoefficient="0.7" middleThreshold="30" bottomCoefficient="0.15"/>
        </tankProfile>
        <tankProfile code="TANK_DAHEKOU_UPSTREAM_V1" areaFactor="4691" routingMode="TO_TANK3">
            <evaporation threshold1="2.7" threshold2="10" value1="2.7" value2="1.5" value3="1"/>
            <tank1 upperCoefficient="0.15" upperThreshold="70" middleCoefficient="0.15" middleThreshold="50"
                   lowerCoefficient="0.15" lowerThreshold="20" infiltrationCoefficient="0.15"/>
            <tank2 outflowCoefficient="0.15" outflowThreshold="6" percolationCoefficient="0.15"/>
            <tank3 middleCoefficient="0.7" middleThreshold="28" bottomCoefficient="0.2"/>
        </tankProfile>
        <tankProfile code="TANK_YANGONG_INTERVAL_V1" areaFactor="4133" routingMode="DIRECT_RUNOFF">
            <evaporation threshold1="2" threshold2="10" value1="2" value2="1.2" value3="0.8"/>
            <tank1 upperCoefficient="0.3" upperThreshold="60" middleCoefficient="0.25" middleThreshold="30"
                   lowerCoefficient="0.2" lowerThreshold="15" infiltrationCoefficient="0.1"/>
            <tank2 outflowCoefficient="0.05" outflowThreshold="60" percolationCoefficient="0.01"/>
            <tank3 middleCoefficient="0.01" middleThreshold="40" bottomCoefficient="0.01"/>
        </tankProfile>
        <tankProfile code="TANK_GONGPENG_INTERVAL_V1" areaFactor="3321" routingMode="DIRECT_RUNOFF">
            <evaporation threshold1="1.5" threshold2="10" value1="1.5" value2="0.9" value3="0.7"/>
            <tank1 upperCoefficient="0.15" upperThreshold="50" middleCoefficient="0.15" middleThreshold="25"
                   lowerCoefficient="0.15" lowerThreshold="10" infiltrationCoefficient="0.15"/>
            <tank2 outflowCoefficient="0.1" outflowThreshold="20" percolationCoefficient="0.1"/>
            <tank3 middleCoefficient="0.1" middleThreshold="20" bottomCoefficient="0.1"/>
        </tankProfile>
    </parameterProfiles>

    <!--
      point.key是模型字段，senid填写生产历史库完整点号，weight只用于雨量加权。
      API电站curveName必须填写CURVE.NAME中的完整单位线名称。
      gfs.regionId可填写一个或多个REGID，多个值使用英文逗号分隔；regionWeight为对应子区面积。
      预报降雨始终读取AVERPRE，多个子区按regionWeight进行面积加权。
    -->
    <stations>
        <station code="API_YUJIANKOU" name="鱼剑口区间" model="API_PPAR_UH" params="API_YUJIANKOU_V1"
                 curveName="鱼剑口水库.基础参数及单位线">
            <resultPoint kind="API" field="*" idAttrCode="21400102031010"/>
            <gfs regionId="2140010101" subtype="10050"/>
            <point key="rainfall" name="大月坝" senid="1443059275481344.M12000" weight="0.20"/>
            <point key="rainfall" name="回龙" senid="1443059268927744.M12000" weight="0.20"/>
            <point key="rainfall" name="栗子" senid="1443059272261888.M12000" weight="0.20"/>
            <point key="rainfall" name="石板水坝上" senid="1443556462354688.M12000" weight="0.20"/>
            <point key="rainfall" name="鱼剑口坝上" senid="1443556478640384.M12000" weight="0.20"/>
        </station>

        <station code="API_JIAOMUTANG" name="角木塘" model="API_PPAR_UH" params="API_JIAOMUTANG_V1"
                 curveName="角木塘水库.基础参数及单位线">
            <point key="measuredFlow" name="实测流量" senid="1442268967534848.W14000"/>
            <resultPoint kind="API" field="*" idAttrCode="16300102031004"/>
            <gfs regionId="1630010101" subtype="10050"/>
            <point key="rainfall" name="鱼塘坝上" senid="1443555331350784.M12000" weight="0.094"/>
            <point key="rainfall" name="五家院子" senid="1443057978171648.M12000" weight="0.108"/>
            <point key="rainfall" name="大矸" senid="1443057981694208.M12000" weight="0.253"/>
            <point key="rainfall" name="三桥" senid="1443057985265920.M12000" weight="0.227"/>
            <point key="rainfall" name="梅江" senid="1443057992417536.M12000" weight="0.292"/>
            <point key="rainfall" name="角木塘坝上" senid="1443555365609728.M12000" weight="0.026"/>
        </station>

        <station code="API_TENGZIGOU_UPSTREAM" name="藤子沟水库以上" model="API_PPAR_UH"
                 params="API_TENGZIGOU_UPSTREAM_V1" curveName="藤子沟水库.基础参数及单位">
            <point key="measuredFlow" name="实测流量" senid="1442269007413504.W14000"/>
            <resultPoint kind="API" field="*" idAttrCode="21100102031004"/>
            <gfs regionId="2110010101" subtype="10050"/>
            <point key="rainfall" name="黄水" senid="1443059236946176.M12000" weight="0.160"/>
            <point key="rainfall" name="悦来" senid="1443059239862528.M12000" weight="0.188"/>
            <point key="rainfall" name="三益" senid="1443059243581696.M12000" weight="0.169"/>
            <point key="rainfall" name="官田坝" senid="1443059262628096.M12000" weight="0.231"/>
            <point key="rainfall" name="沙子" senid="1443059246915840.M12000" weight="0.208"/>
            <point key="rainfall" name="藤子沟坝上" senid="1443556426604800.M12000" weight="0.044"/>
        </station>

        <station code="API_TENGZIGOU_NIULANKOU" name="藤子沟至牛栏口区间" model="API_PPAR_UH"
                 params="API_TENGZIGOU_NIULANKOU_V1" curveName="牛栏口水库.基础参数及单位线">
            <resultPoint kind="API" field="*" idAttrCode="21200102031010"/>
            <gfs regionId="2120010101" subtype="10050"/>
            <point key="rainfall" name="藤子沟坝上" senid="1443556426604800.M12000" weight="0.132"/>
            <point key="rainfall" name="蚕溪" senid="1443059250135296.M12000" weight="0.142"/>
            <point key="rainfall" name="石柱" senid="1443059233399040.M12000" weight="0.322"/>
            <point key="rainfall" name="龙沙" senid="1443059256303872.M12000" weight="0.133"/>
            <point key="rainfall" name="龙池坝" senid="1443059253223680.M12000" weight="0.170"/>
            <point key="rainfall" name="牛栏口坝上" senid="1443556443627776.M12000" weight="0.101"/>
        </station>

        <station code="TANK_JIANGBIN_UPSTREAM" name="江滨以上" model="THREE_LAYER_TANK"
                 params="TANK_JIANGBIN_UPSTREAM_V1">
            <resultPoint kind="TANK" field="*" idAttrCode="11802203021004"/>
            <gfs regionId="2000000007" subtype="10051"/>
            <point key="rainfall" name="砚山" senid="1442852573462784.M12000" weight="0.05"/>
            <point key="rainfall" name="绥阳场" senid="1442852537647360.M12000" weight="0.28"/>
