            <point key="goupitanOutflow" name="构皮滩出库" senid="1442213902123264.W14100"/>
        </station>
    </stations>

    <aggregations>
        <aggregation code="PENGSHUI_INFLOW_FORECAST" displayName="加权平均" operation="sum">
            <source station="TANK_JIANGBIN_UPSTREAM"/>
            <source station="TANK_DAHEKOU_UPSTREAM"/>
            <source station="TANK_YANGONG_INTERVAL"/>
            <source station="TANK_GONGPENG_INTERVAL"/>
            <source station="TANK_PENGSHUI_INFLOW" point="shatuoOutflow"/>
        </aggregation>
    </aggregations>
</forecast-station-model-config>
