        <station code="TANK_YANGONG_INTERVAL" name="沿龚区间" model="THREE_LAYER_TANK"
                 params="TANK_YANGONG_INTERVAL_V1">
            <resultPoint kind="TANK" field="*" idAttrCode="11802403021010"/>
            <gfs regionId="2000000004" subtype="10051"/>
            <point key="rainfall" name="边山" senid="1442852580442368.M12000" weight="0.01"/>
