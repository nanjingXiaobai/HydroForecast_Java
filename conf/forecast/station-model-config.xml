            <point key="rainfall" name="天馆" senid="1442852568858880.M12000" weight="0.11"/>
            <point key="rainfall" name="铜西" senid="1442852555211008.M12000" weight="0.14"/>
            <point key="rainfall" name="小河" senid="1442852551958784.M12000" weight="0.18"/>
            <point key="rainfall" name="沿河" senid="1442851202294016.M12000" weight="0.14"/>
        </station>

        <station code="TANK_GONGPENG_INTERVAL" name="龚彭区间" model="THREE_LAYER_TANK"
                 params="TANK_GONGPENG_INTERVAL_V1">
            <resultPoint kind="TANK" field="*" idAttrCode="11800103021028"/>
            <gfs regionId="2000000005" subtype="10051"/>
            <point key="rainfall" name="边山" senid="1442852580442368.M12000" weight="0.08"/>
            <point key="rainfall" name="梯子洞" senid="1442852620722432.M12000" weight="0.06"/>
            <point key="rainfall" name="大元" senid="1442852587135232.M12000" weight="0.09"/>
            <point key="rainfall" name="龚滩" senid="1442852600463616.M12000" weight="0.03"/>
            <point key="rainfall" name="红丝" senid="1442852576542976.M12000" weight="0.12"/>
